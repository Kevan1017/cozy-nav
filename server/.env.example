# 服务端口
PORT=3001

# 运行环境：development（开发，返回详细错误）或 production（生产，隐藏内部错误）
# 部署到服务器时必须设为 production
NODE_ENV=development

# JWT 密钥（生产环境请改为随机长字符串，至少 32 位）
JWT_SECRET=cozy-nav-secret-change-me

# 允许跨域的来源（生产环境请改为你的前端域名，如 https://nav.yourdomain.com）
# 多个用逗号分隔，开发环境默认允许所有来源
CORS_ORIGIN=

# 浏览器扩展 ID 白名单（可选，生产环境建议配置）：允许来自这些扩展的跨域请求
# 多个用逗号分隔；扩展 ID 可在 chrome://extensions 页面查看
# 不配置时默认放行所有 chrome-extension:// 来源（扩展仍需 JWT 鉴权）
CORS_EXTENSIONS=

# 管理员默认账号（首次启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 种子演示数据开关（可选，默认 true）
# 设为 false 时首次启动只建 admin 账号和默认搜索引擎，不写入示例分类与书签（纯净启动）
SEED_DEMO_DATA=true
